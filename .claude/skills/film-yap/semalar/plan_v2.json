{
 "$schema": "http://json-schema.org/draft-07/schema#",
 "$id": "plan_v2",
 "title": "SAHNELER.json v2 — plan, sahne grubu planı ve harita şeması (TASARIM §5.1; [YN2] §4.5)",
 "description": "plan_sema.py ile doğrulanır (jsonschema varsa o, yoksa yerleşik doğrulayıcı). 'x-sozluk' özel anahtarı değerin veri/ sözlüğünde bulunmasını ister: 'plan:<bölüm>' plan_sozlukleri.json bölümünün anahtarları ya da liste öğeleri, 'fiil' fiil_sozlugu.json fiilleri, 'ifade' ifade_sozlugu.json değerleri. Tek ayırt edici _surum'dur: yoksa ya da 1 ise v1 (bu şema uygulanmaz).",
 "definitions": {
  "sayi": {"type": "number", "minimum": 0},
  "kimlik": {"type": "string", "pattern": "^[a-z0-9_]+$"},
  "el": {"type": "object", "required": ["tutar", "yer", "sekil"],
         "properties": {"tutar": {"type": ["string", "null"]}, "yer": {"type": "string"}, "sekil": {"type": "string", "x-sozluk": "plan:el_sekli"}},
         "additionalProperties": false},
  "durum_karakter": {"type": "object",
   "properties": {"mekan": {"type": "string"}, "isaret": {"type": "string"}, "poz": {"type": "string", "x-sozluk": "plan:poz"},
                  "yuz_yonu": {}, "bakis": {"type": "object", "properties": {"hedef": {"type": ["string", "null"]}}},
                  "kostum": {"type": "string"}, "kostum_durumu": {"type": "array", "items": {"type": "string"}},
                  "gorunum": {"type": "object"}, "eller": {"type": "object", "properties": {"sag": {"$ref": "#/definitions/el"}, "sol": {"$ref": "#/definitions/el"}},
                  "additionalProperties": false},
                  "ifade": {"type": "string", "x-sozluk": "ifade"}, "duygu": {"type": "object"}, "gizli_arkasinda": {"type": ["string", "null"]}},
   "additionalProperties": false},
  "durum": {"type": "object",
   "properties": {"karakterler": {"type": "object", "additionalProperties": {"$ref": "#/definitions/durum_karakter"}},
                  "nesneler": {"type": "object", "additionalProperties": {"type": "object",
                     "properties": {"kimde": {"type": ["string", "null"]}, "el": {"enum": ["sag", "sol", null]}, "nerede": {"type": ["string", "null"]},
                                    "durum": {"type": ["string", "null"]}}, "additionalProperties": false}},
                  "mekan_durumu": {"type": "object"}, "zaman": {"type": "object"}},
   "additionalProperties": false},
  "adim": {"type": "object", "required": ["id", "bas", "bit", "ozne", "tur", "fiil"],
   "properties": {"id": {"type": "string", "pattern": "^a[0-9]+$"}, "bas": {"$ref": "#/definitions/sayi"}, "bit": {"$ref": "#/definitions/sayi"},
                  "ozne": {"type": "string"}, "tur": {"type": "string", "x-sozluk": "plan:adim_tur"}, "fiil": {"type": "string", "x-sozluk": "fiil"},
                  "govde": {"type": "string", "x-sozluk": "plan:govde"}, "yon": {"type": "string", "x-sozluk": "plan:yon"}, "hedef": {"type": "string"},
                  "olcu": {"type": "string"}, "el_sekli": {"type": "string", "x-sozluk": "plan:el_sekli"}, "hiz": {"type": "string", "x-sozluk": "plan:hiz"},
                  "etki": {"type": "object"}, "replik": {"type": "string", "pattern": "^R[0-9]{4}$"},
                  "cumleler": {"type": "array", "items": {"type": "integer", "minimum": 0}}},
   "additionalProperties": false},
  "kadrajdaki": {"type": "object", "required": ["id", "olcek", "yuz_acisi"],
   "properties": {"id": {"type": "string"}, "olcek": {"type": "string", "x-sozluk": "plan:olcek"}, "yuz_acisi": {"type": "string", "x-sozluk": "plan:yuz_acisi"},
                  "konusur": {"type": "boolean"}, "kimlik_demiri": {"type": "boolean"}, "gorunen": {"type": "array", "items": {"type": "string"}}},
   "additionalProperties": false},
  "kamera": {"type": "object", "required": ["kurulum", "kadraj", "hareket_tipi"],
   "properties": {"kurulum": {"type": "string", "pattern": "^KAM[0-9]+$"}, "kadraj": {"type": "string", "x-sozluk": "plan:kadraj"},
                  "aci": {"type": "string", "x-sozluk": "plan:aci"}, "lens_mm": {"type": "number", "minimum": 10, "maximum": 300},
                  "hareket_tipi": {"type": "string", "x-sozluk": "plan:hareket_tipi"}, "hareket_yonu": {"type": ["string", "null"]},
                  "odak": {"type": ["string", "null"]}},
   "additionalProperties": false},
  "zincir": {"type": "object", "required": ["gecis_turu", "baslangic"],
   "properties": {"gecis_turu": {"type": "string", "x-sozluk": "plan:zincir_gecis_turu"}, "onceki_plan": {"type": ["string", "integer", "null"]},
                  "baslangic": {"type": "string", "x-sozluk": "plan:zincir_baslangic"}, "ebeveyn": {"type": ["string", "null"]},
                  "dogal_durak": {"type": "boolean"}, "bitis_sabitle": {"type": "boolean"}},
   "additionalProperties": false},
  "kesme": {"type": "object", "required": ["tip"],
   "properties": {"tip": {"type": "string", "x-sozluk": "plan:kesme_tip"}, "ses_tasma_sn": {"type": "number", "minimum": -3, "maximum": 3}},
   "additionalProperties": false},
  "oyunculuk": {"type": "object", "additionalProperties": {"type": "object",
   "properties": {"ic_durum": {"type": "string"}, "alt_metin": {"type": "string"},
                  "dis_ifade": {"type": "object", "required": ["bas"], "properties": {"bas": {"type": "string", "x-sozluk": "ifade"}, "bit": {"type": "string", "x-sozluk": "ifade"}},
                                "additionalProperties": false},
                  "isaretler": {"type": "array", "items": {"type": "string"}}, "siddet": {"type": "integer", "minimum": 0, "maximum": 3},
                  "duygu": {"type": "object"}, "notr_neden": {"type": "string"}, "ifade_gecis_neden": {"type": "string"}},
   "required": ["dis_ifade"], "additionalProperties": false}},
  "zanaat": {"type": "object",
   "required": ["kod", "sahne_grubu", "plan_tipi", "klip_sn", "kamera", "kadrajdakiler", "baslangic_durumu", "eylem_zinciri", "bitis_durumu", "zincir",
                "kesme", "ekranda_bilgi", "risk_uretim"],
   "properties": {"kod": {"type": "string", "pattern": "^S[0-9]{2,}[a-z]?-P[0-9]{2,}[a-z]?$"}, "sahne_grubu": {"type": "string", "pattern": "^S[0-9]{2,}[a-z]?$"},
                  "plan_tipi": {"type": "string", "x-sozluk": "plan:plan_tipi"}, "klip_sn": {"enum": [8, 10]}, "kaynak_klip": {"type": ["integer", "null"]},
                  "kamera": {"$ref": "#/definitions/kamera"}, "eksen_gecis": {"type": "boolean"},
                  "kadrajdakiler": {"type": "array", "items": {"$ref": "#/definitions/kadrajdaki"}},
                  "baslangic_durumu": {"anyOf": [{"const": "miras"},
                                                 {"type": "object", "required": ["fark"], "properties": {"fark": {"type": "object"}, "neden": {"type": "string"},
                                                  "kadraj_disi": {"type": "boolean"}}, "additionalProperties": false},
                                                 {"$ref": "#/definitions/durum"}]},
                  "eylem_zinciri": {"type": "array", "items": {"$ref": "#/definitions/adim"}, "maxItems": 3},
                  "bitis_durumu": {"anyOf": [{"const": "derlenir"}, {"$ref": "#/definitions/durum"}]},
                  "oyunculuk": {"$ref": "#/definitions/oyunculuk"}, "zincir": {"$ref": "#/definitions/zincir"}, "kesme": {"$ref": "#/definitions/kesme"},
                  "ekran_disi_ses": {"type": ["object", "null"]}, "isik_degisimi": {"type": ["object", "null"]},
                  "ekranda_bilgi": {"type": "string", "minLength": 5}, "yasaklar": {"type": "array", "items": {"type": "string"}},
                  "risk_uretim": {"type": "string", "x-sozluk": "plan:risk_uretim"}, "istem_elle": {"type": ["object", "null"]}, "ses": {},
                  "vurus": {"type": ["string", "null"]}, "hedef_duygu": {"type": ["string", "null"]}, "yogunluk": {"type": ["integer", "null"], "minimum": 0, "maximum": 10},
                  "merak_ac": {"type": "array"}, "merak_kapat": {"type": "array"}, "kurulum": {"type": "array"}, "kullanim_bilgi": {"type": "array"},
                  "ironi": {}, "vaat_imgesi": {}},
   "additionalProperties": false},
  "kullanim": {"type": "object", "required": ["bas", "sure"],
               "properties": {"bas": {"$ref": "#/definitions/sayi"}, "sure": {"type": "number", "exclusiveMinimum": 0}}, "additionalProperties": false},
  "ajan_plani": {"type": "object", "required": ["kullanim", "zanaat"],
   "properties": {"kullanim": {"$ref": "#/definitions/kullanim"}, "amac": {"type": "string"}, "replik": {"anyOf": [{"type": "null"}, {"type": "string"},
                  {"type": "object", "required": ["id"]}]}, "zanaat": {"$ref": "#/definitions/zanaat"}},
   "additionalProperties": false},
  "sahne_plan_dosyasi": {"type": "object", "required": ["sahne_grubu", "planlar"],
   "properties": {"sahne_grubu": {"type": "string", "pattern": "^S[0-9]{2,}[a-z]?$"}, "planlar": {"type": "array", "minItems": 1, "items": {"$ref": "#/definitions/ajan_plani"}},
                  "not": {"type": "string"}},
   "additionalProperties": false},
  "kurulum": {"type": "object", "required": ["konum", "yon_derece", "lens_mm", "ebeveyn"],
   "properties": {"konum": {"type": "array", "items": {"type": "number"}, "minItems": 2, "maxItems": 2}, "yon_derece": {"type": "number", "minimum": 0, "maximum": 360},
                  "yukseklik_m": {"type": "number"}, "yukseklik": {}, "lens_mm": {"type": "number", "minimum": 10, "maximum": 300},
                  "varsayilan_kadraj": {"type": "string", "x-sozluk": "plan:kadraj"}, "ebeveyn": {"type": "string"}, "not": {"type": "string"}}},
  "sahne_grubu": {"type": "object", "required": ["mekan", "zaman", "sahne_tipi", "sure_hedef_sn", "plan_hedef", "kalip", "isik", "giris_durumu", "cikis_durumu"],
   "properties": {"hikaye": {"type": "object"}, "mekan": {"type": "string"}, "zaman": {"type": "object", "required": ["gun_saati"]},
                  "sahne_tipi": {"type": "string"}, "sure_hedef_sn": {"type": "number", "minimum": 1}, "plan_hedef": {"type": "integer", "minimum": 1},
                  "kalip": {"type": "string", "x-sozluk": "plan:kalip"}, "eksen": {"type": "array", "maxItems": 2},
                  "kamera_tarafi": {"enum": ["dogu", "bati", "kuzey", "guney", null]}, "ekran_yonu": {"enum": ["soldan_saga", "sagdan_sola", null]},
                  "kurulumlar": {"type": "array", "items": {"type": "string"}}, "isik": {"type": "object"}, "yasaklar": {"type": "array"},
                  "giris_durumu": {}, "cikis_durumu": {}, "canli_arka_plan": {"type": ["string", "null"]}, "ses": {}, "zaman_cizgisi": {"type": "string"},
                  "_derlenir": {}},
   "additionalProperties": false},
  "harita": {"type": "object", "required": ["mekanlar", "sahne_gruplari"],
   "properties": {"parti": {"type": "integer"}, "nesneler": {"type": "object"},
                  "mekanlar": {"type": "object", "additionalProperties": {"type": "object", "required": ["evren", "kurulumlar"],
                               "properties": {"evren": {"type": "string"}, "kurulumlar": {"type": "object", "additionalProperties": {"$ref": "#/definitions/kurulum"}}}}},
                  "sahne_gruplari": {"type": "object", "additionalProperties": {"$ref": "#/definitions/sahne_grubu"}}, "not": {"type": "string"}}},
  "uretim_zarfi": {"type": "object", "required": ["asama", "gorev", "girdi_imza", "arac_surum", "esik_surum", "sonuc", "zaman", "ortam"]},
  "sahneler_plan": {"type": "object", "required": ["no", "sira", "parti", "zanaat"],
   "properties": {"no": {"type": "integer", "minimum": 1}, "sira": {"type": "number"}, "parti": {"type": "integer", "minimum": 0, "maximum": 3},
                  "zanaat": {"$ref": "#/definitions/zanaat"}, "kullanim": {"$ref": "#/definitions/kullanim"}}}
 },
 "type": "object",
 "required": ["_surum", "_uretim", "film", "karakterler", "sahneler"],
 "properties": {"_surum": {"type": "integer", "minimum": 2}, "_sema": {"const": "sahneler_v2"}, "_uretim": {"$ref": "#/definitions/uretim_zarfi"},
                "film": {"type": "string"}, "baslik": {"type": ["string", "null"]}, "altyazi_dili": {"type": ["string", "null"]},
                "karakterler": {"type": "object"}, "mekanlar": {"type": "object"}, "sahne_gruplari": {"type": "object"},
                "sahneler": {"type": "array", "items": {"$ref": "#/definitions/sahneler_plan"}}}
}
